; Engine configuration file.
; Hunt Survivors — iOS portrait prototype.

config_version=5

[application]

config/name="Hunt Survivors"
config/description="Portrait survivors-like hunt prototype: one thumb moves, the other draws gesture moves."
run/main_scene="res://ui/title.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Tuning="*res://autoload/tuning.gd"
ArtRegistry="*res://autoload/art_registry.gd"
GameState="*res://autoload/game_state.gd"
Save="*res://autoload/save.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.09, 1)
